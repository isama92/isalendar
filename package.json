{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint ./resources/**/*.{js,jsx,ts,tsx}",
        "lint:fix": "npm run lint -- --fix",
        "prettier": "prettier ./resources/**/*.{js,jsx,ts,tsx,css} ./*.{js,mjs} --check --log-level error",
        "prettier:fix": "prettier ./resources/**/*.{js,jsx,ts,tsx,css} ./*.{js,mjs} --write --log-level error",
        "format": "npm run prettier:fix && npm run lint:fix",
        "type-check": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@tailwindcss/vite": "^4.1.18",
        "@types/node": "^25.0.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^16.5.0",
        "laravel-vite-plugin": "^2.0.1",
        "prettier": "^3.7.4",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.9.3",
        "vite": "^7.2.7"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.9",
        "@heroicons/react": "^2.2.0",
        "@inertiajs/react": "^2.3.0",
        "@tailwindcss/typography": "^0.5.19",
        "@tanstack/react-table": "^8.21.3",
        "@tiptap/pm": "^3.13.0",
        "@tiptap/react": "^3.13.0",
        "@tiptap/starter-kit": "^3.13.0",
        "axios": "^1.13.2",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.19",
        "echarts": "^6.0.0",
        "echarts-for-react": "^3.0.5",
        "es-toolkit": "^1.42.0",
        "react": "^19.2.3",
        "react-day-picker": "^9.12.0",
        "react-dom": "^19.2.3",
        "react-select": "^5.10.2",
        "ziggy-js": "^2.6.0"
    }
}
