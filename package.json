{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint ./resources/**/*.{js,jsx}",
        "lint:fix": "npm run lint -- --fix",
        "prettier": "prettier ./resources/**/*.{js,jsx,css} ./*.{js,mjs} --check --log-level error",
        "prettier:fix": "prettier ./resources/**/*.{js,jsx,css} ./*.{js,mjs} --write --log-level error",
        "format": "npm run prettier:fix && npm run lint:fix"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-react": "^5.1.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^15.15.0",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.6.2",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.9",
        "@heroicons/react": "^2.2.0",
        "@inertiajs/react": "^2.2.6",
        "@tailwindcss/typography": "^0.5.19",
        "@tanstack/react-table": "^8.21.3",
        "@tiptap/pm": "^3.7.0",
        "@tiptap/react": "^3.7.0",
        "@tiptap/starter-kit": "^3.7.0",
        "axios": "^1.12.2",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.18",
        "echarts": "^5.6.0",
        "echarts-for-react": "^3.0.2",
        "es-toolkit": "^1.41.0",
        "react": "^19.2.0",
        "react-day-picker": "^9.11.1",
        "react-dom": "^19.2.0",
        "react-select": "^5.10.2",
        "ziggy-js": "^2.6.0"
    }
}
