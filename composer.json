{
    "name": "isama92/isalendar",
    "description": "Add events to a shared calendar.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "isama92",
        "isalendar"
    ],
    "require": {
        "php": "^8.5",
        "google/apiclient": "^2.18",
        "inertiajs/inertia-laravel": "^2.0.28",
        "intervention/image": "^3.11",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.50",
        "laravel/socialite": "^5.23",
        "laravel/tinker": "^3.0",
        "spatie/laravel-csp": "^3.30",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-queueable-action": "^2.17",
        "staudenmeir/eloquent-has-many-deep": "^1.22",
        "tightenco/ziggy": "^2.6",
        "torann/geoip": "^3.0.10"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "defstudio/pest-plugin-laravel-expectations": "^2.6.2",
        "driftingly/rector-laravel": "^2.7.3",
        "ergebnis/composer-normalize": "^2.48",
        "fakerphp/faker": "^1.23",
        "jasonmccreary/laravel-test-assertions": "^2.9",
        "larastan/larastan": "^3.13",
        "laravel-lang/common": "^6.8",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "phpmd/phpmd": "^2.15",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.8.1",
        "roave/security-advisories": "dev-latest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "analyze": "phpstan analyze --memory-limit=2048M",
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run lint",
            "npm run prettier",
            "npm run type-check",
            "@lint:check",
            "@refactor:check",
            "@test"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": [
            "pint",
            "npm run format"
        ],
        "lint:check": "pint --test",
        "mess": "phpmd . ansi phpmd.ruleset.xml --exclude 'tests/*,vendor/*,node_modules/*,storage/*'",
        "refactor": "rector process",
        "refactor:check": "rector process --dry-run",
        "static": [
            "@refactor",
            "@lint",
            "@analyze",
            "@mess"
        ],
        "suite": [
            "@refactor",
            "@lint",
            "@analyze",
            "@mess",
            "@test"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "pest"
        ]
    },
    "scripts-descriptions": {
        "analyze": "Runs static analysis",
        "ci:check": "Runs the tests and every style check CI runs, without fixing anything",
        "lint": "Correct the code style of all PHP and JS files",
        "lint:check": "Checks the PHP code style without fixing it",
        "mess": "Checks for potential code problems",
        "refactor": "Run refactoring tools",
        "refactor:check": "Shows pending Rector refactors without applying them",
        "static": "Run the static CI suite of checks",
        "suite": "Run the full CI suite of checks",
        "test": "Run the test suite"
    },
    "$schema": "https://getcomposer.org/schema.json"
}
