{
    "name": "isama92/isalendar",
    "description": "Add events to a shared calendar.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "isama92",
        "isalendar"
    ],
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "spatie/laravel-permission": "^6.21",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "defstudio/pest-plugin-laravel-expectations": "^2.6",
        "driftingly/rector-laravel": "^2.0",
        "ergebnis/composer-normalize": "^2.48",
        "fakerphp/faker": "^1.23",
        "jasonmccreary/laravel-test-assertions": "^2.8",
        "larastan/larastan": "^3.7",
        "laravel/boost": "^1.3",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.1",
        "phpmd/phpmd": "^2.15",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.1",
        "roave/security-advisories": "dev-latest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "analyse": "phpstan analyse --memory-limit=-1",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": [
            "pint",
            "npm run format"
        ],
        "mess": "phpmd . ansi phpmd.ruleset.xml --exclude 'tests/*,vendor/*,node_modules/*,storage/*'",
        "refactor": "rector process",
        "static": [
            "@refactor",
            "@lint",
            "@analyse",
            "@mess"
        ],
        "suite": [
            "@refactor",
            "@lint",
            "@analyse",
            "@mess",
            "@test"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "pest"
        ]
    },
    "scripts-descriptions": {
        "analyse": "Runs static analysis",
        "lint": "Correct the code style of all PHP and JS files",
        "mess": "Checks for potential code problems",
        "refactor": "Run refactoring tools",
        "static": "Run the static CI suite of checks",
        "suite": "Run the full CI suite of checks",
        "test": "Run the test suite"
    },
    "$schema": "https://getcomposer.org/schema.json"
}
